# Copy to .env.local and fill in the values.
# In production, api.ts uses relative URLs via CloudFront — no env vars needed.
# These are only needed for local dev (direct Lambda access).

# Lambda Function URL for the Ticket Service (CDK output: TicketFunctionUrl)
# Leave empty to use CloudFront routing (/api/tickets → ticket-service).
VITE_TICKET_SERVICE_URL=

# API key for the Ticket Service (required when VITE_TICKET_SERVICE_URL is set)
# aws secretsmanager get-secret-value --secret-id agora/services-api-key --query SecretString --output text
VITE_TICKET_API_KEY=

# --- Chat proxy (proxy.py) env vars, NOT exposed to browser ---
# ARN of the Gateway Agent AgentCore Runtime (CDK output: AgoraGatewayRuntimeArn)
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:agent-runtime/xxxx
AWS_REGION=us-east-1
